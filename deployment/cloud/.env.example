# Public URL of the app (no trailing slash). Must match how users reach public/.
# Local Docker: http://localhost:8080
# Production:   https://your-app.up.railway.app
APP_URL=http://localhost:8080

# MySQL connection (used by config/database.php)
# Docker Compose: host is the service name "db"
# Railway/Render: use the host/port from your managed MySQL add-on
V2_DB_HOST=db
V2_DB_PORT=3306
V2_DB_NAME=restaurant_v2
V2_DB_USER=restaurant_user
V2_DB_PASS=restaurant_v2_pass

# Docker Compose only — root password for the bundled mysql:8 service
MYSQL_ROOT_PASSWORD=rootpassword

# Docker Compose only — host port mapped to the web container (default 8080)
WEB_PORT=8080
