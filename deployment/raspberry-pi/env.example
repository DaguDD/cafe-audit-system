# Cafe Audit System — Raspberry Pi environment (optional)
# Copy to /etc/cafe-audit/env on the Pi if you use install.sh database overrides.
# Most settings are in V2/config/app.php and V2/config/database.php.

# Public URL (no trailing slash) — set to Pi IP or local hostname
APP_URL=http://192.168.1.50

# MariaDB (defaults match install.sh)
V2_DB_HOST=127.0.0.1
V2_DB_PORT=3306
V2_DB_NAME=restaurant_v2
V2_DB_USER=restaurant_user
V2_DB_PASS=restaurant_v2_pass
